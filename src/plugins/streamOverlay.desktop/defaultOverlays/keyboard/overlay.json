{
    "title": "Keyboard",
    "category": "Input",
    "description": "The keys you press, lit up as you press them, in a default or a gothic look. Hold Alt + Caps to move or resize it.",
    "keys": ["TAB", "Q", "W", "E", "R", "T", "CAPS", "A", "S", "D", "F", "G", "SHIFT", "Z", "X", "C", "V", "B", "CTRL", "SPACE"],
    "interactive": ["ALT", "CAPS"],
    "draggable": true,
    "settings": [
        {
            "id": "theme",
            "type": "select",
            "label": "Theme",
            "group": "Look",
            "default": "default",
            "options": [
                { "label": "Default", "value": "default" },
                { "label": "Gothic", "value": "gothic" }
            ]
        },
        { "id": "letter-accent", "type": "color", "label": "Letter keys accent", "group": "Look", "when": { "theme": "default" }, "default": "#8b5cf6" },
        { "id": "g-letter-accent", "type": "color", "label": "Letter keys accent", "group": "Look", "when": { "theme": "gothic" }, "default": "#e4def0" },
        { "id": "modifier-accent", "type": "color", "label": "Modifier keys accent", "group": "Look", "when": { "theme": "default" }, "default": "#22d3ee" },
        { "id": "g-modifier-accent", "type": "color", "label": "Modifier keys accent", "group": "Look", "when": { "theme": "gothic" }, "default": "#b3122e" },
        { "id": "shadow", "type": "color", "label": "Shadow color", "group": "Look", "default": "#000000" },
        { "id": "scale", "type": "number", "label": "Scale", "group": "Layout", "min": 0.6, "max": 2, "step": 0.05, "default": 1 },
        {
            "id": "position",
            "type": "select",
            "label": "Position",
            "group": "Layout",
            "default": "bottom-left",
            "options": [
                { "label": "Bottom left", "value": "bottom-left" },
                { "label": "Bottom right", "value": "bottom-right" },
                { "label": "Top left", "value": "top-left" },
                { "label": "Top right", "value": "top-right" },
                { "label": "Custom (moved by hand)", "value": "custom" }
            ]
        },
        { "id": "x", "type": "number", "label": "X", "min": 0, "max": 20000, "step": 1, "unit": "px", "default": 0, "hidden": true },
        { "id": "y", "type": "number", "label": "Y", "min": 0, "max": 20000, "step": 1, "unit": "px", "default": 0, "hidden": true }
    ]
}
