{
    "title": "Spotify",
    "description": "The track that is playing in Spotify, with its cover and progress. Needs Spotify linked to Discord. Hold Alt + Caps to move or resize it.",
    "media": true,
    "interactive": ["ALT", "CAPS"],
    "draggable": true,
    "settings": [
        { "id": "accent", "type": "color", "label": "Accent", "default": "#8b5cf6" },
        { "id": "accent2", "type": "color", "label": "Second accent", "default": "#22d3ee" },
        { "id": "shadow", "type": "color", "label": "Shadow color", "default": "#000000" },
        { "id": "cover", "type": "boolean", "label": "Show the cover", "default": true },
        { "id": "progress", "type": "boolean", "label": "Show the progress", "default": true },
        { "id": "bars", "type": "boolean", "label": "Animated bars", "default": true },
        { "id": "hide-idle", "type": "boolean", "label": "Hide when nothing is playing", "default": false },
        { "id": "scale", "type": "number", "label": "Scale", "min": 0.6, "max": 2, "step": 0.05, "default": 1 },
        {
            "id": "position",
            "type": "select",
            "label": "Position",
            "default": "top-left",
            "options": [
                { "label": "Bottom left", "value": "bottom-left" },
                { "label": "Bottom right", "value": "bottom-right" },
                { "label": "Top left", "value": "top-left" },
                { "label": "Top right", "value": "top-right" },
                { "label": "Custom (moved by hand)", "value": "custom" }
            ]
        },
        { "id": "x", "type": "number", "label": "X", "min": 0, "max": 20000, "step": 1, "unit": "px", "default": 0, "hidden": true },
        { "id": "y", "type": "number", "label": "Y", "min": 0, "max": 20000, "step": 1, "unit": "px", "default": 0, "hidden": true }
    ]
}
