{
    "title": "Spotify",
    "category": "Media",
    "description": "The track that is playing in Spotify, with its cover and progress, in a default or a gothic look. Needs Spotify linked to Discord. Hold Alt + Caps to move or resize it.",
    "media": true,
    "interactive": ["ALT", "CAPS"],
    "draggable": true,
    "settings": [
        {
            "id": "theme",
            "type": "select",
            "label": "Theme",
            "group": "Look",
            "default": "default",
            "options": [
                { "label": "Default", "value": "default" },
                { "label": "Gothic", "value": "gothic" }
            ]
        },
        {
            "id": "font",
            "type": "font",
            "label": "Font",
            "group": "Look",
            "default": "default",
            "options": [
                { "label": "Default", "value": "default" },
                { "label": "Gothic blackletter", "value": "ObnoxiousGothic" },
                { "label": "Consolas", "value": "Consolas" },
                { "label": "Georgia", "value": "Georgia" },
                { "label": "Palatino Linotype", "value": "Palatino Linotype" }
            ]
        },
        {
            "id": "font-weight",
            "type": "select",
            "label": "Font weight",
            "group": "Look",
            "when": { "theme": "default" },
            "default": "600",
            "options": [
                { "label": "Regular", "value": "400" },
                { "label": "Medium", "value": "500" },
                { "label": "Semibold", "value": "600" },
                { "label": "Bold", "value": "700" }
            ]
        },
        {
            "id": "g-font-weight",
            "type": "select",
            "label": "Font weight",
            "group": "Look",
            "when": { "theme": "gothic" },
            "default": "700",
            "options": [
                { "label": "Regular", "value": "400" },
                { "label": "Medium", "value": "500" },
                { "label": "Semibold", "value": "600" },
                { "label": "Bold", "value": "700" }
            ]
        },
        { "id": "letter-spacing", "type": "number", "label": "Letter spacing", "group": "Look", "when": { "theme": "default" }, "min": 0, "max": 0.3, "step": 0.01, "unit": "em", "default": 0.01 },
        { "id": "g-letter-spacing", "type": "number", "label": "Letter spacing", "group": "Look", "when": { "theme": "gothic" }, "min": 0, "max": 0.3, "step": 0.01, "unit": "em", "default": 0 },
        { "id": "text-scale", "type": "number", "label": "Text size", "group": "Look", "min": 0.7, "max": 1.6, "step": 0.05, "default": 1 },
        { "id": "accent", "type": "color", "label": "Accent", "group": "Look", "when": { "theme": "default" }, "default": "#8b5cf6" },
        { "id": "g-accent", "type": "color", "label": "Accent", "group": "Look", "when": { "theme": "gothic" }, "default": "#e4def0" },
        { "id": "accent2", "type": "color", "label": "Second accent", "group": "Look", "when": { "theme": "default" }, "default": "#22d3ee" },
        { "id": "g-accent2", "type": "color", "label": "Second accent", "group": "Look", "when": { "theme": "gothic" }, "default": "#b3122e" },
        { "id": "shadow", "type": "color", "label": "Shadow color", "group": "Look", "default": "#000000" },
        { "id": "cover", "type": "boolean", "label": "Show the cover", "group": "Look", "default": true },
        { "id": "progress", "type": "boolean", "label": "Show the progress", "group": "Look", "default": true },
        { "id": "bars", "type": "boolean", "label": "Animated bars", "group": "Look", "default": true },
        { "id": "scale", "type": "number", "label": "Scale", "group": "Layout", "min": 0.6, "max": 2, "step": 0.05, "default": 1 },
        {
            "id": "position",
            "type": "select",
            "label": "Position",
            "group": "Layout",
            "default": "top-left",
            "options": [
                { "label": "Bottom left", "value": "bottom-left" },
                { "label": "Bottom right", "value": "bottom-right" },
                { "label": "Top left", "value": "top-left" },
                { "label": "Top right", "value": "top-right" },
                { "label": "Custom (moved by hand)", "value": "custom" }
            ]
        },
        { "id": "hide-idle", "type": "boolean", "label": "Hide when nothing is playing", "group": "Layout", "default": false },
        { "id": "x", "type": "number", "label": "X", "min": 0, "max": 20000, "step": 1, "unit": "px", "default": 0, "hidden": true },
        { "id": "y", "type": "number", "label": "Y", "min": 0, "max": 20000, "step": 1, "unit": "px", "default": 0, "hidden": true }
    ]
}
